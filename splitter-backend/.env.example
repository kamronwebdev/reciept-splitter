# Environment variables for splitter-backend

# Server
PORT=3001

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Database URL (set by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Optional (see README)
# CORS_ORIGINS=http://localhost:8081
# PUBLIC_BASE_URL=https://api.example.com   # origin used in friend QR links (/f/<code>) and avatar URLs
# Receipt scanning (Gemini). Without a key the scan endpoint answers GEMINI_NOT_CONFIGURED (no silent fake data).
# GEMINI_API_KEY=
# GEMINI_MODEL_PARSE=            # optional: force a model; default = best generateContent model from ListModels
# GEMINI_TIMEOUT_MS=45000
# GEMINI_API_BASE=               # testing only: point at a fake Gemini server
# RECEIPT_MOCK=1                 # dev only: explicit demo receipt (flagged source "mock"); ignored in production
# JSON_BODY_LIMIT=8mb            # receipt photos are sent as base64 JSON

# Password reset emails. The server uses the first one that is configured:
#   1. Resend: RESEND_API_KEY (+ EMAIL_FROM on a domain verified in Resend; the onboarding@resend.dev
#      test sender only delivers to your own Resend account address)
#   2. SMTP, e.g. Gmail: SMTP_USER + SMTP_PASS (a Gmail *app password*, not your normal password).
#      Sends to any address; EMAIL_FROM is optional (defaults to SMTP_USER)
#   3. nothing set: the 6-digit code is printed to the server console:
#      [DEV] Reset code for user@example.com: 123456
RESEND_API_KEY=
EMAIL_FROM=
SMTP_USER=
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
