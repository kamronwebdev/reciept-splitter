# Environment variables for splitter-backend

# Server
PORT=3001

# JWT secret key
JWT_SECRET=your_jwt_secret_here

# Database URL (set by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Optional (see README)
# CORS_ORIGINS=http://localhost:8081
# GEMINI_API_KEY=

# Password reset emails (Resend). If RESEND_API_KEY is empty, the 6-digit code is printed to the server console:
#   [DEV] Reset code for user@example.com: 123456
RESEND_API_KEY=
EMAIL_FROM="Receipt Splitter <onboarding@resend.dev>"
