# Backend base URL. Leave empty in development: Expo Go auto-detects your computer's IP (port 3001).
# For a real phone on another network or a production build set it explicitly, e.g.:
# EXPO_PUBLIC_API_URL=https://splitter-backend-qeig.onrender.com
EXPO_PUBLIC_API_URL=

# Address used by Settings > About > Support & feedback
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Verbose [API]/HISTORY request logging (off by default)
# EXPO_PUBLIC_DEBUG_API=1
