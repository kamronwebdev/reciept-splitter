{
  "expo": {
    "name": "Receipt Splitter",
    "slug": "receipt-splitter",
    "icon": "./assets/icon.png",
    "scheme": "receipt-splitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jduapp.receiptsplitter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Receipt Splitter saves your friend QR code to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Receipt Splitter uses the camera to scan receipts and friends' QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05fc7a2d-813f-4121-9103-860ef1313a37"
      }
    },
    "owner": "jduapp"
  }
}
